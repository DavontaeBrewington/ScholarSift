{
  "manifest_version": 3,
  "name": "ScholarSift — Academic Paper Saver",
  "version": "1.0.0",
  "description": "Save academic papers from arXiv, PubMed, and Google Scholar directly to your ScholarSift collections.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://scholar.google.com/*",
    "http://localhost:8000/*",
    "https://*.scholarsift.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScholarSift — Save this paper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://scholar.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
