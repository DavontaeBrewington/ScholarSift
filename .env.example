# ── ScholarSift Environment Configuration ────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# At least one of OPENROUTER_API_KEY or OPENAI_API_KEY is required
# for AI-powered features (AI overviews, chat, summarization, translation).

# LLM API Keys (at least one required for AI features)
OPENROUTER_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Model Selection
# CHAT_MODEL is used for the chat assistant (/api/chat)
CHAT_MODEL=deepseek/deepseek-chat
# OVERVIEW_MODEL is used for AI overviews, summaries, and translation
OVERVIEW_MODEL=deepseek/deepseek-chat

# Optional: Custom OpenAI-compatible base URL
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
